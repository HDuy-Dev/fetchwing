{
  "manifest_version": 3,
  "name": "Fetchwing",
  "version": "0.1.0",
  "description": "A lightweight API client in DevTools: paste cURL, send requests, organise collections and mock responses for web pages.",
  "devtools_page": "src/devtools.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fetchwing"
  },
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "clipboardRead",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://openidconnect.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
